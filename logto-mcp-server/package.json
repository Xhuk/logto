{
  "name": "logto-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Logto Management API, with multi-tenant (N domains) support.",
  "type": "module",
  "private": true,
  "bin": {
    "logto-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js",
    "register-cursor-client": "node dist/register-cursor-client.js",
    "dev": "tsc -w -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "node --test dist/access.test.js dist/config.test.js dist/tenant-endpoints.test.js dist/tools/shared.test.js dist/tools/explicit-auth.test.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-auth": "^1.0.0-beta.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
