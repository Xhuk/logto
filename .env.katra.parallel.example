# Copy to a gitignored .env next to docker-compose.katra.parallel.yml.
# Do not reuse the live OSS Logto Postgres credentials.

POSTGRES_USER=katra
POSTGRES_PASSWORD=
POSTGRES_DB=katra

# Wildcard enables domain-based tenancy. Product logins use custom domains, not this glob.
ENDPOINT=https://*.idp.kairova.services

# Concrete CNAME target advertised and checked by logto_verify_domain.
DOMAIN_CNAME_TARGET=idp.kairova.services

# Staff console. Tailscale only — do not put a product auth host here.
ADMIN_ENDPOINT=https://dokploy-vps.tailfadff7.ts.net:8444

TENANT_MANAGEMENT_M2M_ROLE_NAMES=mcp

KATRA_PORT=3101
KATRA_ADMIN_PORT=3102
KATRA_POSTGRES_PORT=3103
