# Base URL that serves the Logto Management API.
# Katra on the VPS: the Tailscale admin, not the old public OSS host.
LOGTO_ENDPOINT=https://katra-imperial.tailfadff7.ts.net:8443

# Machine-to-machine credentials for the Management API. Stay on the MCP server;
# Cursor OAuth does not use them. Aliases: LOGTO_APP_ID / LOGTO_APP_SECRET.
LOGTO_MCP_CLIENT_ID=
LOGTO_MCP_CLIENT_SECRET=

# Admin-tenant Management API audience. Per-tenant audiences stay https://{tenantId}.logto.app/api.
LOGTO_MCP_RESOURCE=https://admin.logto.app/api
# LOGTO_API_INDICATOR=https://admin.logto.app/api

# Optional. Space-separated Management API scopes. Defaults to "all".
# LOGTO_MCP_SCOPE=all

# Path-based tenants on Katra: https://<magicdns>/{tenantId}
# The admin tenant is the ADMIN host, not that path. Put it in LOGTO_TENANT_ENDPOINTS.
LOGTO_TENANT_ENDPOINT_TEMPLATE=https://katra-imperial.tailfadff7.ts.net/{tenantId}
LOGTO_TENANT_RESOURCE_TEMPLATE=https://{tenantId}.logto.app/api
# LOGTO_TENANT_ENDPOINTS=admin=https://katra-imperial.tailfadff7.ts.net:8443

# Optional. Staff map of tenant id → custom-domain Management API base.
# LOGTO_TENANT_ENDPOINTS=a4x0qj=https://auth.lotly.lat,xyz=https://auth.vetgroom.services

# --- HTTP + Cursor OAuth (staff) ---
# Set MCP_HTTP_PORT to serve Streamable HTTP instead of stdio.
MCP_HTTP_PORT=3301
MCP_HTTP_HOST=127.0.0.1
MCP_PUBLIC_URL=http://127.0.0.1:3301/mcp

# RFC 8707 resource indicator (token `aud`). Must match mcp.json `url` exactly.
# MCP_OAUTH_RESOURCE=http://127.0.0.1:3301/mcp
MCP_OAUTH_SCOPES=mcp:all

# Cursor OAuth issuer. This is what opens the Katra login, the same card other Cursor MCP apps use.
LOGTO_OIDC_ISSUER=https://katra-imperial.tailfadff7.ts.net:8443/oidc

# Optional. Comma-separated Logto user ids (`sub`) allowed to use the MCP.
# LOGTO_MCP_ALLOWED_SUBJECTS=

# Optional. Assign the Staff MCP role to this user when running register-cursor-client.
# LOGTO_MCP_STAFF_USER_ID=
