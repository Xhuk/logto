# Base URL that serves the Logto Management API.
# In a multi-tenant deployment this is the admin tenant endpoint, e.g. https://admin.example.com
LOGTO_ENDPOINT=http://localhost:3001

# Credentials of a machine-to-machine application that can access the Management API.
LOGTO_MCP_CLIENT_ID=
LOGTO_MCP_CLIENT_SECRET=

# Optional. Management API resource indicator (token audience).
# Defaults to https://admin.logto.app/api
# LOGTO_MCP_RESOURCE=https://admin.logto.app/api

# Optional. Space-separated scopes to request. Defaults to "all".
# LOGTO_MCP_SCOPE=all
